# --- Aegra (worker runtime) ---
AEGRA_CONFIG=aegra.json
HOST=0.0.0.0
PORT=2026
ENV_MODE=LOCAL
LOG_LEVEL=INFO

# Postgres: docker compose exposes pgvector on host port 5433 (local 5432 is taken)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegra
POSTGRES_USER=aegra
POSTGRES_PASSWORD=aegra

# In-process job queue by default. Set true + start `docker compose --profile redis up -d`
REDIS_BROKER_ENABLED=false
REDIS_URL=redis://localhost:6380/0

# Auth: real switch is the `auth` block in aegra.json. Env alone enforces nothing.
AUTH_TYPE=noop

# Cron scheduler is unused in this project
CRON_ENABLED=false

# --- Models ---
# models/default alias resolves to this provider model (src/wigtn_agents/models.py)
ANTHROPIC_API_KEY=
WIGTN_AGENT_DEFAULT_MODEL=anthropic:claude-sonnet-4-6
# Daily model cost cap in USD (UTC day). Over it, model calls are refused and var/gaps.jsonl
# gets a cost_cap line. A model missing from wigtn_agents/budget.py PRICES needs both prices set.
WIGTN_AGENT_DAILY_COST_CAP_USD=10
# WIGTN_AGENT_PRICE_INPUT_PER_MTOK=
# WIGTN_AGENT_PRICE_OUTPUT_PER_MTOK=
# Offline runtime integration without an LLM key: scripted fake model (src/wigtn_agents/testing.py).
# Never set in a real deployment.
# WIGTN_AGENT_FAKE_MODEL=1
# Event log written by EventRecorderMiddleware (JSONL)
WIGTN_AGENT_EVENT_LOG=var/events.jsonl

# --- Observability (optional) ---
# Each tool is switched on by its own settings and off by leaving them empty.
# Langfuse and Phoenix: Aegra fans its OpenInference spans out to the targets listed here.
# OTEL_TARGETS=LANGFUSE,PHOENIX
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# Phoenix files spans under this project name (default project otherwise).
# OTEL_RESOURCE_ATTRIBUTES=openinference.project.name=wigtn-agents
# LangSmith: LangChain's own tracer, independent of the OpenTelemetry targets.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=wigtn-agents
