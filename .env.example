# --- Aegra (worker runtime) ---
AEGRA_CONFIG=aegra.json
HOST=0.0.0.0
PORT=2026
ENV_MODE=LOCAL
LOG_LEVEL=INFO

# Postgres: docker compose exposes pgvector on host port 5433 (local 5432 is taken)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegra
POSTGRES_USER=aegra
POSTGRES_PASSWORD=aegra

# In-process job queue by default. Set true + start `docker compose --profile redis up -d`
REDIS_BROKER_ENABLED=false
REDIS_URL=redis://localhost:6380/0

# Auth: real switch is the `auth` block in aegra.json. Env alone enforces nothing.
AUTH_TYPE=noop

# Cron scheduler is unused in this project
CRON_ENABLED=false

# --- Models ---
# Aliases, providers and prices live in catalog/models.yaml; this file only holds keys and endpoints.
# models/default = gpt-6-luna on the OpenAI Responses API
OPENAI_API_KEY=
# Open-weight backbones and the default judge on MARA Cloud (OpenAI-compatible; endpoint and
# prices are in catalog/models.yaml). A local vLLM entry uses base_url_env instead.
MARACLOUD_API_KEY=
# Daily model cost cap in USD (UTC day). Over it, model calls are refused and var/gaps.jsonl
# gets a cost_cap line.
WIGTN_AGENT_DAILY_COST_CAP_USD=10
# Offline runtime integration without an LLM key: every alias becomes the scripted fake model
# (src/wigtn_agents/testing.py). Never set in a real deployment. models/fake does the same per run.
# WIGTN_AGENT_FAKE_MODEL=1

# --- Records ---
# Event log written by EventRecorderMiddleware (JSONL), and the jsonl writeback port of actions
WIGTN_AGENT_EVENT_LOG=var/events.jsonl
WIGTN_AGENT_ACTION_LOG=var/actions.jsonl

# --- Tool bindings ---
# secret://a/b in an api asset or catalog/mcp.yaml is read from WIGTN_SECRET_A_B at call time.
# WIGTN_SECRET_RECORDS_BASE_URL=
# WIGTN_SECRET_RECORDS_SERVICE_ACCOUNT=
# MCP server URLs named by url_env in catalog/mcp.yaml
# WIGTN_MCP_DOCS_URL=

# --- Tracing (optional) ---
# One set of OpenInference spans per run, sent to every target listed here (any or all).
# OTEL_TARGETS=LANGFUSE,PHOENIX,LANGSMITH
# Langfuse
# LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# Phoenix (project name via the resource attribute; default project otherwise)
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces   # Phoenix Cloud: https://app.phoenix.arize.com/s/<space>/v1/traces
# PHOENIX_API_KEY=
# OTEL_RESOURCE_ATTRIBUTES=openinference.project.name=wigtn-agents
# LangSmith, through its OTLP endpoint. Keep LANGSMITH_TRACING off: with an OTLP target on, the
# runtime refuses to start, because LangSmith's own tracer splits the traces of the other tools.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wigtn-agents
# Regional or self-hosted LangSmith: LANGSMITH_ENDPOINT (the API URL; /otel/v1/traces is appended),
# or the full OTLP URL in LANGSMITH_OTEL_ENDPOINT.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces
